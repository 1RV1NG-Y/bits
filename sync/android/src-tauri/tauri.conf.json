{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bits sync",
  "version": "0.1.0",
  "identifier": "com.bits.syncprototype",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://127.0.0.1:5175",
    "beforeBuildCommand": "npm run sync:ui",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [{ "title": "bits sync", "width": 420, "height": 820 }],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
