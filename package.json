{
  "name": "bits",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Small pieces of information, ready when you need them.",
  "author": "bits",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5174 && electron . --dev\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "package": "npm run build && electron-builder --linux AppImage tar.gz",
    "install:linux": "node scripts/install-linux.mjs",
    "setup:ocr": "node scripts/setup-ocr.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.0.12",
    "jsdom": "^30.1.1",
    "vite": "^8.3.0",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.bits.knowledge",
    "productName": "bits",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/model.mjs",
      "build/icon.png",
      "package.json"
    ],
    "linux": {
      "category": "Utility",
      "icon": "build/icon.png",
      "executableName": "bits",
      "artifactName": "bits-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "StartupWMClass": "bits"
        }
      },
      "syncDesktopName": true
    },
    "extraResources": [
      {
        "from": "ocr",
        "to": "ocr-support/ocr",
        "filter": [
          "worker.py",
          "requirements.txt"
        ]
      },
      {
        "from": "scripts/setup-ocr.mjs",
        "to": "ocr-support/scripts/setup-ocr.mjs"
      }
    ]
  },
  "desktopName": "bits.desktop"
}
