{
  "name": "bits",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Small pieces of information, ready when you need them.",
  "author": "bits",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5174 && electron . --dev\"",
    "build": "vite build",
    "start": "npm run sync:helper && npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "package": "npm run sync:helper && npm run build && electron-builder --linux AppImage tar.gz",
    "package:win": "npm run sync:helper && npm run build && electron-builder --win zip --x64",
    "install:linux": "node scripts/install-linux.mjs",
    "setup:ocr": "node scripts/setup-ocr.mjs",
    "sync:helper": "cargo build --release --manifest-path sync/Cargo.toml -p bits-sync-helper",
    "sync:test": "cargo test --manifest-path sync/Cargo.toml && npm run sync:helper && node --test sync/tests/*.test.mjs",
    "tauri": "tauri",
    "sync:android": "node sync/android/build-apk.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/cli": "^2.12.1",
    "@tauri-apps/plugin-barcode-scanner": "^2.5.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.0.12",
    "jsdom": "^30.1.1",
    "vite": "^8.3.0",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.bits.knowledge",
    "productName": "bits",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/model.mjs",
      "build/icon.png",
      "package.json"
    ],
    "linux": {
      "category": "Utility",
      "icon": "build/icon.png",
      "executableName": "bits",
      "artifactName": "bits-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "StartupWMClass": "bits"
        }
      },
      "syncDesktopName": true,
      "extraResources": [
        {
          "from": "sync/target/release/bits-sync-helper",
          "to": "bits-sync-helper"
        }
      ]
    },
    "extraResources": [
      {
        "from": "ocr",
        "to": "ocr-support/ocr",
        "filter": [
          "worker.py",
          "requirements.txt"
        ]
      },
      {
        "from": "scripts/setup-ocr.mjs",
        "to": "ocr-support/scripts/setup-ocr.mjs"
      }
    ],
    "win": {
      "target": "zip",
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "artifactName": "bits-${version}-win-${arch}.${ext}",
      "extraResources": [
        {
          "from": "sync/target/release/bits-sync-helper.exe",
          "to": "bits-sync-helper.exe"
        }
      ]
    }
  },
  "desktopName": "bits.desktop"
}
